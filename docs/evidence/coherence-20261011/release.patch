+  hy: { chapter: "Ավտոմատացում", nav: { title: "LocalOS-ը գտնում է կրկնվող գործերը", body: "Այն ստուգում է քարտեզները, ակնարկները, Telegram-ը և նորությունները և ցույց է տալիս, թե որտեղ է անհրաժեշտ գործողություն: Պետք չէ ինքներդ ստուգել յուրաքանչյուր աղբյուր:" }, signals: { title: "Յուրաքանչյուր գործ տալիս է արդյունք", body: "LocalOS-ը կարող է պատրաստել վերանայման պատասխան, հրապարակման գաղափար կամ փոփոխությունների ցանկ: Դուք ամեն ինչ վերանայում եք ուղարկելուց կամ հրապարակելուց առաջ:" }, today: { title: "Այն, ինչ ավարտվեց այսօր", body: "Ամփոփագիրը ցույց է տալիս պատրաստված նյութերը, վերանայման սպասվող կետերը և ձեր որոշման կարիք ունեցող սխալները:" }, employees: { title: "Ընտրեք ավտոմատացված առաջադրանք", body: "Քարտը ցույց է տալիս, թե ինչ է ստուգում LocalOS-ը, երբ ստուգումն է աշխատում, և որ արդյունքն արդեն պատրաստ է։" }, control: { title: "Դուք մնում եք վերահսկողության տակ", body: "Չեկերը կատարվում են ըստ պահանջի կամ ժամանակացույցի: Առանց ձեր հաստատման ոչինչ չի հրապարակվում կամ ուղարկվում:" }, run: { title: "Կատարեք նմուշի ստուգում", body: "Դեմոում LocalOS-ը գտնում է չորս անպատասխան ակնարկներ և յուրաքանչյուրի համար պատրաստում առանձին նախագիծ։" }, review: { title: "Վերանայեք պատրաստված նախագծերը", body: "Կարդացեք պատասխանները և անհրաժեշտության դեպքում խմբագրեք դրանք: Ոչինչ չի հրապարակվում, քանի դեռ չեք հաստատել արդյունքը։" }, history: { title: "Դիտեք ավարտված առաջադրանքների պատմությունը", body: "Տեսեք, թե երբ է ստուգումը կատարվել, ինչ տվյալներ է այն օգտագործել, ինչ է պատրաստվել և ով է հաստատել արդյունքը:" } },};
