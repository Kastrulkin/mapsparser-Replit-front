+SPA_ENTRY_ROUTES = {
+    "/", "/about", "/pricing", "/contact", "/policy", "/privacy",
+    "/data-deletion", "/requisites", "/docs", "/login", "/demo",
+    "/articles", "/documents", "/cases", "/bazich", "/dashboard-old",
