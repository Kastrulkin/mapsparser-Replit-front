(version 1)
(allow default)
(allow process*)
(deny file-read* (subpath "/Users"))
(deny network*)
(allow network-outbound (remote ip "localhost:62956"))
(deny file-write*)
(allow file-write* (subpath "/private/tmp/localos-schema-pg7.c72qakfx"))
(allow file-write* (literal "/dev/null"))
(deny file-write* (subpath "/private/tmp/localos-schema-pg7.c72qakfx/guard"))
