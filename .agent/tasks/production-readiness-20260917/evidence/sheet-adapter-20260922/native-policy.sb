(version 1)
(allow default)
(allow process*)
(deny file-read* (subpath "/Users"))
(deny network*)
(allow network-outbound (remote ip "localhost:52960"))
(deny file-write*)
(allow file-write* (subpath "/private/tmp/localos-sheet-wrapper-pg20.son1iimr"))
(allow file-write* (literal "/dev/null"))
(deny file-write* (subpath "/private/tmp/localos-sheet-wrapper-pg20.son1iimr/guard"))
