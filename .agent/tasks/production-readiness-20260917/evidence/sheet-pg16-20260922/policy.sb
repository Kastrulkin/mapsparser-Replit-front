(version 1)
(allow default)
(allow process*)
(deny file-read* (subpath "/Users"))
(deny network*)
(allow network-outbound (remote ip "localhost:50721"))
(deny file-write*)
(allow file-write* (subpath "/private/tmp/localos-sheet-pg16.mknhb6m_"))
(allow file-write* (literal "/dev/null"))
(deny file-write* (subpath "/private/tmp/localos-sheet-pg16.mknhb6m_/guard"))
