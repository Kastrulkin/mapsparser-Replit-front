(version 1)
(allow default)
(deny network*)
(allow network-outbound (remote ip "localhost:62048"))
(deny file-read* (subpath "/Users"))
(deny file-write*)
(allow file-write* (literal "/dev/null"))
(allow file-write* (subpath "/private/tmp/localos-five-stress._nca2inu"))
(deny file-write* (subpath "/private/tmp/localos-five-stress._nca2inu/guard"))
(deny file-write* (subpath "/private/tmp/localos-five-stress._nca2inu/baseline"))
(deny file-write* (subpath "/private/tmp/localos-five-stress._nca2inu/current"))
(deny file-write* (literal "/private/tmp/localos-five-stress._nca2inu/job.json"))
(deny file-write* (literal "/private/tmp/localos-five-stress._nca2inu/sandbox.sb"))
