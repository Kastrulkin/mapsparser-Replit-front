(version 1)
(allow default)
(allow process*)
(deny file-read* (subpath "/Users"))
(deny network*)
(allow network-outbound (remote ip6 "localhost:35418"))
(deny file-write*)
(allow file-write* (subpath "/private/tmp/localos-services55-pg.i5c9as8l"))
(allow file-write* (literal "/dev/null"))
(deny file-write* (subpath "/private/tmp/localos-services55-pg.i5c9as8l/guard"))
