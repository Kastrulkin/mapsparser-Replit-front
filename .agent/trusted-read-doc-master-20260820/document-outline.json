{
  "version": 1,
  "kind": "google-docs-normalized-read",
  "document": {
    "documentId": "1kQqpnxEr83Kfnw5CK3sSitwWEhMfLlhpeAR4oXE6tDc",
    "title": "Ведение КПИ в YClients",
    "revisionId": "AIroW34iQ-8O0bt-Xxp1xX_m3l6jkVAfi_02SpzWakDNon7neomSgI53_9Iwff0vbpmvj1UQ91QQ5Dy0BiRSb6ZkQBafmYDVNtOmwhP7rUc",
    "documentUrl": "https://docs.google.com/document/d/1kQqpnxEr83Kfnw5CK3sSitwWEhMfLlhpeAR4oXE6tDc"
  },
  "selectedTabId": "t.0",
  "controlSummary": {
    "total": 0,
    "opaque": 0,
    "authoritativeDropdowns": 0,
    "affectedParagraphs": 0
  },
  "paragraphs": [
    {
      "paragraphId": "P00001",
      "path": "tabs.t.0.body.content[1]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1,
      "endIndex": 53,
      "namedStyleType": "TITLE",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Как администратору вести YCLIENTS и получать бонусы",
      "protectedControls": []
    },
    {
      "paragraphId": "P00002",
      "path": "tabs.t.0.body.content[2]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 53,
      "endIndex": 128,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Главное правило: нет отметки в YCLIENTS - нет действия в расчёте зарплаты.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00003",
      "path": "tabs.t.0.body.content[3]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 128,
      "endIndex": 282,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Работайте только под своей учётной записью. Если запись создана из общего аккаунта, нельзя понять, кто сделал предзапись, вернул клиента или спас отмену.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00004",
      "path": "tabs.t.0.body.content[4]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 282,
      "endIndex": 300,
      "namedStyleType": "HEADING_2",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "1. Закройте визит",
      "protectedControls": []
    },
    {
      "paragraphId": "P00005",
      "path": "tabs.t.0.body.content[5]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 300,
      "endIndex": 388,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Когда клиент пришёл, откройте его запись и поставьте статус «Клиент пришел». Проверьте:",
      "protectedControls": []
    },
    {
      "paragraphId": "P00006",
      "path": "tabs.t.0.body.content[6]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 388,
      "endIndex": 423,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.18up6yuvw70x",
      "nestingLevel": null,
      "table": null,
      "text": "выбран правильный клиент и мастер;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00007",
      "path": "tabs.t.0.body.content[7]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 423,
      "endIndex": 453,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.18up6yuvw70x",
      "nestingLevel": null,
      "table": null,
      "text": "внесены все оказанные услуги;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00008",
      "path": "tabs.t.0.body.content[8]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 453,
      "endIndex": 482,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.18up6yuvw70x",
      "nestingLevel": null,
      "table": null,
      "text": "цены и итоговая сумма верны;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00009",
      "path": "tabs.t.0.body.content[9]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 482,
      "endIndex": 522,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.18up6yuvw70x",
      "nestingLevel": null,
      "table": null,
      "text": "все проданные товары добавлены в визит.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00010",
      "path": "tabs.t.0.body.content[10]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 522,
      "endIndex": 612,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Без статуса «Клиент пришел» визит не попадёт в выручку, явку, возвраты и расчёт зарплаты.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00011",
      "path": "tabs.t.0.body.content[11]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 612,
      "endIndex": 650,
      "namedStyleType": "HEADING_2",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "2. Если продали дополнительную услугу",
      "protectedControls": []
    },
    {
      "paragraphId": "P00012",
      "path": "tabs.t.0.body.content[12]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 650,
      "endIndex": 739,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Доп - услуга, которой не было в первоначальной записи и которую продали во время визита.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00013",
      "path": "tabs.t.0.body.content[13]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 739,
      "endIndex": 783,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.6am52d7tfw0",
      "nestingLevel": null,
      "table": null,
      "text": "Добавьте услугу в визит как обычную услугу.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00014",
      "path": "tabs.t.0.body.content[14]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 783,
      "endIndex": 821,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.6am52d7tfw0",
      "nestingLevel": null,
      "table": null,
      "text": "Укажите мастера, который её выполнил.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00015",
      "path": "tabs.t.0.body.content[15]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 821,
      "endIndex": 871,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.6am52d7tfw0",
      "nestingLevel": null,
      "table": null,
      "text": "В комментарии к записи укажите услугу и продавца.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00016",
      "path": "tabs.t.0.body.content[16]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 871,
      "endIndex": 925,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Шаблон: ДОП | услуга: Уход для волос | продал: Ульяна",
      "protectedControls": []
    },
    {
      "paragraphId": "P00017",
      "path": "tabs.t.0.body.content[17]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 925,
      "endIndex": 1052,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Если допов несколько, внесите каждый с новой строки. Не пишите просто «доп» и не оставляйте отметку только в карточке клиента.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00018",
      "path": "tabs.t.0.body.content[18]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1052,
      "endIndex": 1127,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "В зарплате: мастер получает 5% от суммы допуслуги. \u000b\u000b3. Если продали товар",
      "protectedControls": []
    },
    {
      "paragraphId": "P00019",
      "path": "tabs.t.0.body.content[19]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1127,
      "endIndex": 1315,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Добавьте товар через продажу в визите. Не прибавляйте его стоимость к услуге и не ограничивайтесь комментарием. Проверьте товар, количество, цену и сотрудника, которому относится продажа.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00020",
      "path": "tabs.t.0.body.content[20]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1315,
      "endIndex": 1372,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "В зарплате: мастер получает 10% от своих продаж товаров.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00021",
      "path": "tabs.t.0.body.content[21]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1372,
      "endIndex": 1411,
      "namedStyleType": "HEADING_2",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "4. Запишите клиента на следующий визит",
      "protectedControls": []
    },
    {
      "paragraphId": "P00022",
      "path": "tabs.t.0.body.content[22]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1411,
      "endIndex": 1499,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "До ухода клиента предложите ему выбрать дату следующего приёма. Если клиент согласился:",
      "protectedControls": []
    },
    {
      "paragraphId": "P00023",
      "path": "tabs.t.0.body.content[23]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1499,
      "endIndex": 1547,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.jzaqrzmznhk4",
      "nestingLevel": null,
      "table": null,
      "text": "создайте будущую запись в день текущего визита;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00024",
      "path": "tabs.t.0.body.content[24]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1547,
      "endIndex": 1611,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.jzaqrzmznhk4",
      "nestingLevel": null,
      "table": null,
      "text": "используйте существующую карточку клиента, не создавайте дубль;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00025",
      "path": "tabs.t.0.body.content[25]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1611,
      "endIndex": 1654,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.jzaqrzmznhk4",
      "nestingLevel": null,
      "table": null,
      "text": "создайте запись под своей учётной записью;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00026",
      "path": "tabs.t.0.body.content[26]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1654,
      "endIndex": 1686,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.jzaqrzmznhk4",
      "nestingLevel": null,
      "table": null,
      "text": "отдельный комментарий не нужен.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00027",
      "path": "tabs.t.0.body.content[27]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1686,
      "endIndex": 1875,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "В зарплате: 250 ₽ начисляется администратору только после того, как клиент действительно придёт на следующий визит. Отмена и неявка не оплачиваются. Предзапись также влияет на KPI мастера.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00028",
      "path": "tabs.t.0.body.content[28]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1875,
      "endIndex": 1911,
      "namedStyleType": "HEADING_2",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "5. Если вернули потерянного клиента",
      "protectedControls": []
    },
    {
      "paragraphId": "P00029",
      "path": "tabs.t.0.body.content[29]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1911,
      "endIndex": 2026,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Реактивация - клиент из базы, который давно не посещал салон и вернулся после звонка или сообщения администратора.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00030",
      "path": "tabs.t.0.body.content[30]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2026,
      "endIndex": 2065,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.65w86pgmj2yt",
      "nestingLevel": null,
      "table": null,
      "text": "Найдите существующую карточку клиента.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00031",
      "path": "tabs.t.0.body.content[31]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2065,
      "endIndex": 2108,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.65w86pgmj2yt",
      "nestingLevel": null,
      "table": null,
      "text": "Создайте запись под своей учётной записью.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00032",
      "path": "tabs.t.0.body.content[32]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2108,
      "endIndex": 2161,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.65w86pgmj2yt",
      "nestingLevel": null,
      "table": null,
      "text": "В комментарии напишите: РЕАКТИВАЦИЯ | продал: Ульяна",
      "protectedControls": []
    },
    {
      "paragraphId": "P00033",
      "path": "tabs.t.0.body.content[33]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2161,
      "endIndex": 2208,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.65w86pgmj2yt",
      "nestingLevel": null,
      "table": null,
      "text": "После визита поставьте статус «Клиент пришел».",
      "protectedControls": []
    },
    {
      "paragraphId": "P00034",
      "path": "tabs.t.0.body.content[34]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2208,
      "endIndex": 2322,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "В зарплате: 500 ₽ начисляется только за клиента, который пришёл. Запись без состоявшегося визита не оплачивается.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00035",
      "path": "tabs.t.0.body.content[35]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2322,
      "endIndex": 2344,
      "namedStyleType": "HEADING_2",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "6. Если спасли отмену",
      "protectedControls": []
    },
    {
      "paragraphId": "P00036",
      "path": "tabs.t.0.body.content[36]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2344,
      "endIndex": 2449,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Спасённая отмена - клиент хотел отменить визит, а администратор договорился о переносе или новой записи.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00037",
      "path": "tabs.t.0.body.content[37]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2449,
      "endIndex": 2484,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.xnz253eu4ufe",
      "nestingLevel": null,
      "table": null,
      "text": "Не удаляйте первоначальную запись.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00038",
      "path": "tabs.t.0.body.content[38]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2484,
      "endIndex": 2540,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.xnz253eu4ufe",
      "nestingLevel": null,
      "table": null,
      "text": "Перенесите её или создайте новую на согласованную дату.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00039",
      "path": "tabs.t.0.body.content[39]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2540,
      "endIndex": 2609,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.xnz253eu4ufe",
      "nestingLevel": null,
      "table": null,
      "text": "В комментарии новой записи напишите: СПАСЕНА ОТМЕНА | продал: Ульяна",
      "protectedControls": []
    },
    {
      "paragraphId": "P00040",
      "path": "tabs.t.0.body.content[40]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2609,
      "endIndex": 2656,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.xnz253eu4ufe",
      "nestingLevel": null,
      "table": null,
      "text": "После визита поставьте статус «Клиент пришел».",
      "protectedControls": []
    },
    {
      "paragraphId": "P00041",
      "path": "tabs.t.0.body.content[41]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2656,
      "endIndex": 2749,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "В зарплате: 300 ₽ начисляется только после фактического визита. Сам перенос не оплачивается.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00042",
      "path": "tabs.t.0.body.content[42]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2749,
      "endIndex": 2794,
      "namedStyleType": "HEADING_2",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "7. Не оставляйте прошедшие записи в ожидании",
      "protectedControls": []
    },
    {
      "paragraphId": "P00043",
      "path": "tabs.t.0.body.content[43]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2794,
      "endIndex": 2827,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.sejsn8ee4cne",
      "nestingLevel": null,
      "table": null,
      "text": "клиент пришёл — «Клиент пришел»;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00044",
      "path": "tabs.t.0.body.content[44]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2827,
      "endIndex": 2871,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.sejsn8ee4cne",
      "nestingLevel": null,
      "table": null,
      "text": "не пришёл без предупреждения — «Не пришел»;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00045",
      "path": "tabs.t.0.body.content[45]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2871,
      "endIndex": 2910,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.sejsn8ee4cne",
      "nestingLevel": null,
      "table": null,
      "text": "отменил заранее — зафиксируйте отмену;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00046",
      "path": "tabs.t.0.body.content[46]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2910,
      "endIndex": 2964,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.sejsn8ee4cne",
      "nestingLevel": null,
      "table": null,
      "text": "перенёс визит — перенесите запись или создайте новую.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00047",
      "path": "tabs.t.0.body.content[47]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2964,
      "endIndex": 3080,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "В зарплате: при явке не ниже 92% администратор получает 5 000 ₽. Незакрытые и неверные статусы искажают показатель.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00048",
      "path": "tabs.t.0.body.content[48]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3080,
      "endIndex": 3106,
      "namedStyleType": "HEADING_2",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "8. Перед окончанием смены",
      "protectedControls": []
    },
    {
      "paragraphId": "P00049",
      "path": "tabs.t.0.body.content[49]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3106,
      "endIndex": 3132,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Проверьте записи за день:",
      "protectedControls": []
    },
    {
      "paragraphId": "P00050",
      "path": "tabs.t.0.body.content[50]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3132,
      "endIndex": 3181,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.5vlndff1zbyd",
      "nestingLevel": null,
      "table": null,
      "text": "у каждой прошедшей записи стоит итоговый статус;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00051",
      "path": "tabs.t.0.body.content[51]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3181,
      "endIndex": 3217,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.5vlndff1zbyd",
      "nestingLevel": null,
      "table": null,
      "text": "указаны правильные клиент и мастер;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00052",
      "path": "tabs.t.0.body.content[52]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3217,
      "endIndex": 3246,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.5vlndff1zbyd",
      "nestingLevel": null,
      "table": null,
      "text": "внесены все услуги и товары;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00053",
      "path": "tabs.t.0.body.content[53]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3246,
      "endIndex": 3304,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.5vlndff1zbyd",
      "nestingLevel": null,
      "table": null,
      "text": "допы, реактивации и спасённые отмены отмечены по шаблону;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00054",
      "path": "tabs.t.0.body.content[54]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3304,
      "endIndex": 3348,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.5vlndff1zbyd",
      "nestingLevel": null,
      "table": null,
      "text": "будущие записи созданы под вашим аккаунтом;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00055",
      "path": "tabs.t.0.body.content[55]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3348,
      "endIndex": 3383,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.5vlndff1zbyd",
      "nestingLevel": null,
      "table": null,
      "text": "нет дублирующих карточек клиентов;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00056",
      "path": "tabs.t.0.body.content[56]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3383,
      "endIndex": 3436,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.5vlndff1zbyd",
      "nestingLevel": null,
      "table": null,
      "text": "в карточке клиента указан актуальный номер телефона.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00057",
      "path": "tabs.t.0.body.content[57]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3436,
      "endIndex": 3512,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "В зарплате: за правильное ведение CRM в течение месяца начисляется 2 000 ₽.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00058",
      "path": "tabs.t.0.body.content[58]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3512,
      "endIndex": 3560,
      "namedStyleType": "HEADING_2",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "9. Из чего складывается зарплата администратора",
      "protectedControls": []
    },
    {
      "paragraphId": "P00059",
      "path": "tabs.t.0.body.content[59]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3560,
      "endIndex": 3578,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.j3ud3c5kfy7k",
      "nestingLevel": null,
      "table": null,
      "text": "45 000 ₽ — оклад;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00060",
      "path": "tabs.t.0.body.content[60]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3578,
      "endIndex": 3633,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.j3ud3c5kfy7k",
      "nestingLevel": null,
      "table": null,
      "text": "250 ₽ — за состоявшийся повторный визит по предзаписи;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00061",
      "path": "tabs.t.0.body.content[61]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3633,
      "endIndex": 3682,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.j3ud3c5kfy7k",
      "nestingLevel": null,
      "table": null,
      "text": "500 ₽ — за пришедшего реактивированного клиента;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00062",
      "path": "tabs.t.0.body.content[62]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3682,
      "endIndex": 3735,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.j3ud3c5kfy7k",
      "nestingLevel": null,
      "table": null,
      "text": "300 ₽ — за пришедшего клиента после спасения отмены;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00063",
      "path": "tabs.t.0.body.content[63]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3735,
      "endIndex": 3767,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.j3ud3c5kfy7k",
      "nestingLevel": null,
      "table": null,
      "text": "5 000 ₽ — при явке не ниже 92%;",
      "protectedControls": []
    },
    {
      "paragraphId": "P00064",
      "path": "tabs.t.0.body.content[64]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3767,
      "endIndex": 3804,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.j3ud3c5kfy7k",
      "nestingLevel": null,
      "table": null,
      "text": "2 000 ₽ — за правильное ведение CRM.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00065",
      "path": "tabs.t.0.body.content[65]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3804,
      "endIndex": 3915,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Пример: 20 успешных предзаписей, 6 реактиваций, 4 спасённые отмены, явка выше 92% и правильно заполненная CRM.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00066",
      "path": "tabs.t.0.body.content[66]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3915,
      "endIndex": 3982,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Расчёт: 45 000 + 5 000 + 3 000 + 1 200 + 5 000 + 2 000 = 61 200 ₽.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00067",
      "path": "tabs.t.0.body.content[67]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3982,
      "endIndex": 4087,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Важно: предзапись, реактивация и спасённая отмена оплачиваются только после фактического визита клиента.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00068",
      "path": "tabs.t.0.body.content[68]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4087,
      "endIndex": 4088,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    }
  ]
}
